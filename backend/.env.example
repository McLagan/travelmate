# TravelMate Environment Configuration
# Copy this file to .env and update the values

# Application
APP_NAME=TravelMate API
VERSION=0.1.0
DEBUG=true
ENVIRONMENT=development

# Server
HOST=0.0.0.0
PORT=8088

# Database
DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/travelmate_dev

# Security - IMPORTANT: Change these in production!
SECRET_KEY=your-super-secret-key-change-in-production-use-32-chars-minimum
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=24

# CORS - Update for production
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080
ALLOWED_CREDENTIALS=true

# External APIs
OPENSTREETMAP_URL=https://nominatim.openstreetmap.org
OSRM_URL=https://router.project-osrm.org

# Rate Limiting (requests per minute)
RATE_LIMIT_SEARCH=20
RATE_LIMIT_ROUTES=30
RATE_LIMIT_AUTH=5

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# Optional: Production settings
# DATABASE_POOL_SIZE=10
# DATABASE_MAX_OVERFLOW=20
# REDIS_URL=redis://localhost:6379
# SENTRY_DSN=your-sentry-dsn

# Email (password reset, email confirmation)
# Development: leave SMTP_HOST empty - mails go to Mailpit, open http://localhost:8025
# Gmail (no own domain yet): a separate Gmail account, 2-step verification on, then an "app password"
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USER=travelmate.example@gmail.com
# SMTP_PASSWORD=<16-character app password>
# MAIL_FROM=travelmate.example@gmail.com
# Address of the site in links inside emails
APP_BASE_URL=http://localhost:8088
# Only behind your own reverse proxy (Caddy/nginx): take the client IP from X-Forwarded-For
# TRUST_PROXY_HEADERS=true