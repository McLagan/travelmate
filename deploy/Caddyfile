# Caddy obtains and renews Let's Encrypt certificates for SITE_HOST automatically.
{$SITE_HOST} {
	encode zstd gzip
	request_body {
		max_size 20MB
	}
	header {
		-Server
	}
	reverse_proxy backend:8088
	log {
		output stdout
		format console
	}
}

# www -> main domain (needs a DNS record for www too)
www.{$SITE_HOST} {
	redir https://{$SITE_HOST}{uri} permanent
}
