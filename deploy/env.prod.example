# Copy to ./.env on the server (NOT into git), fill in, then: chmod 600 .env
# Replace 1-2-3-4 with the server IP using dashes (sslip.io resolves it to the IP).

SITE_HOST=1-2-3-4.sslip.io
ALLOWED_ORIGINS=https://1-2-3-4.sslip.io
GOOGLE_REDIRECT_URI=https://1-2-3-4.sslip.io/auth/google/callback

# Generate each with:  openssl rand -base64 48 | tr -d '/+=' | cut -c1-48
POSTGRES_PASSWORD=
SECRET_KEY=

LOG_LEVEL=INFO
ACCESS_TOKEN_EXPIRE_HOURS=24

# API keys: copy the same lines from your local backend/.env
# (Claude API key, GEOAPIFY_API_KEY, OPENTRIPMAP_API_KEY, GOOGLE_CLIENT_ID/SECRET, ...)
