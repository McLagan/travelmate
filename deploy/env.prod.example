# Copy to ./.env on the server (NOT into git), fill in, then: chmod 600 .env
# SITE_HOST: your domain (e.g. mandry.live) with A records for @ and www pointing to the server.
# Without a domain: 1-2-3-4.sslip.io where 1-2-3-4 is the server IP with dashes.

SITE_HOST=1-2-3-4.sslip.io
# JSON list: pydantic-settings parses List fields from env as JSON
ALLOWED_ORIGINS=["https://1-2-3-4.sslip.io"]
GOOGLE_REDIRECT_URI=https://1-2-3-4.sslip.io/auth/google/callback

# Generate each with:  openssl rand -base64 48 | tr -d '/+=' | cut -c1-48
POSTGRES_PASSWORD=
SECRET_KEY=

LOG_LEVEL=INFO
ACCESS_TOKEN_EXPIRE_HOURS=24

# API keys: copy the same lines from your local backend/.env
# (Claude API key, GEOAPIFY_API_KEY, OPENTRIPMAP_API_KEY, GOOGLE_CLIENT_ID/SECRET, ...)

# Address of the site in links inside emails (password reset, email confirmation)
APP_BASE_URL=https://mandry.live

# Outgoing email. Without SMTP_HOST nothing is sent in production (password reset will not work).
# Brevo:  SMTP_HOST=smtp-relay.brevo.com  SMTP_PORT=587  SMTP_SECURITY=starttls
#         SMTP_USER=<SMTP login from Brevo>  SMTP_PASSWORD=<SMTP key from Brevo>
# Resend: SMTP_HOST=smtp.resend.com  SMTP_PORT=587  SMTP_SECURITY=starttls  SMTP_USER=resend  SMTP_PASSWORD=<API key>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@mandry.live
